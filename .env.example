# JobAgent Private Secrets & Credentials
# Copy this file to .env and insert your real keys.
# .env is strictly git-ignored! Never commit secrets.

# AWS Bedrock Credentials (if using Bedrock provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional Alternative LLM Providers
GEMINI_API_KEY=

# Optional Email Credentials (Generic IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Optional Gmail App Password (if using direct IMAP)
GMAIL_USER=

# Optional A2A Gateway Bearer API Token (auto-generated if omitted)
JOBAGENT_API_TOKEN=

# --- Effective gateway/storage overrides (env wins over config files) ---
# Optional. These are read at startup and override config.example.json /
# config.local.json values (precedence: env > config.local.json >
# config.example.json > defaults).
# A2A_HOST=127.0.0.1
# A2A_PORT=8765
# JOBAGENT_DB=data/jobagent.db

# --- Generic IMAP overrides (rarely needed: host/port/ssl normally live in config.local.json) ---
# IMAP_USE_SSL=true   # "1", "true", "yes" (any case) -> True; anything else / empty -> False
# IMAP_PORT=993